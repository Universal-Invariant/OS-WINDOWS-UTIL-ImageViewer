<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ImageViewer="clr-namespace:ImageViewer"
        Title="Image Viewer" Height="350" Width="525" Name="MainForm" WindowState="Maximized"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        Background="#FF2D2D30" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Flat, modern toolbar button -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFE1E1E1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle variant: stays highlighted while checked -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFE1E1E1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0E639C"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF75B9E7"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption (min / restore / close) buttons -->
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF1707B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark combobox that fits the toolbar -->
        <Style x:Key="ToolComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="#FFE1E1E1"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Toolbar / custom title bar ======================= -->
        <Grid Name="TB_Main" Background="#FF3E3E42">
            <Grid.ColumnDefinitions>
                <!-- Drag region (double-click maximizes/restores) -->
                <ColumnDefinition Width="*"/>
                <!-- Bg color -->
                <ColumnDefinition Width="Auto"/>
                <!-- Scale label -->
                <ColumnDefinition Width="Auto"/>
                <!-- Scale slider -->
                <ColumnDefinition Width="120"/>
                <!-- Fit-to-width toggle -->
                <ColumnDefinition Width="Auto"/>
                <!-- Recurse toggle -->
                <ColumnDefinition Width="Auto"/>
                <!-- Path combo -->
                <ColumnDefinition Width="Auto"/>
                <!-- Browse folder icon -->
                <ColumnDefinition Width="Auto"/>
                <!-- Settings gear -->
                <ColumnDefinition Width="Auto"/>
                <!-- Minimize -->
                <ColumnDefinition Width="Auto"/>
                <!-- Maximize / Restore -->
                <ColumnDefinition Width="Auto"/>
                <!-- Close -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Transparent drag handle spanning the empty left part of the bar -->
            <Rectangle Grid.Column="0" Fill="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown"
                       Cursor="SizeAll" ToolTip="Drag to move the window"/>

            <Button Grid.Column="1" Name="BtnBgColor" Width="22" Height="22" Margin="2,0,6,0"
                    Click="BtnBgColor_Click" MouseRightButtonUp="BtnBgColor_MouseRightButtonUp"
                    ToolTip="Change background color (left click)">
                <Button.Template>
                    <ControlTemplate>
                        <Border x:Name="border" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"
                                BorderBrush="#FF808080" BorderThickness="1" CornerRadius="3"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Column="2" Text="Scale" Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider Grid.Column="3" x:Name="SD_Scale" VerticalAlignment="Center" Maximum="4.0" Minimum="0.1" Value="1.0"
                    Margin="0,0,6,0" MouseDoubleClick="SD_Scale_MouseDoubleClick" MouseRightButtonUp="SD_Scale_MouseRightButtonUp"/>

            <!-- Two-state "fit images to window width" (book format) toggle -->
            <ToggleButton Grid.Column="4" Name="TGB_FitToWidth" Style="{StaticResource ToggleButtonStyle}"
                          Checked="TGB_FitToWidth_Changed" Unchecked="TGB_FitToWidth_Changed"
                          ToolTip="Fit all images to the window width (book format)">
                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </ToggleButton>

            <!-- Two-state recursion toggle (replaces label + checkbox) -->
            <ToggleButton Grid.Column="5" Name="TGB_Recurse" Style="{StaticResource ToggleButtonStyle}"
                          Checked="CB_Recurse_Changed" Unchecked="CB_Recurse_Changed"
                          ToolTip="Include subdirectories (recursion)">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </ToggleButton>

            <ComboBox Grid.Column="6" x:Name="CB_Path" Style="{StaticResource ToolComboBox}"
                      Width="260" MinWidth="120" IsEditable="True" VerticalContentAlignment="Center"
                      KeyDown="CB_Path_KeyDown" DropDownClosed="CB_Path_DropDownClosed" SelectionChanged="CB_Path_SelectionChanged"/>

            <!-- Browse button (folder icon) - now actually hooked up -->
            <Button Grid.Column="7" Name="BtnBrowse" Style="{StaticResource ToolButton}" Click="BtnBrowse_Click"
                    ToolTip="Browse for a folder...">
                <Canvas Width="18" Height="14">
                    <Path Fill="#FFFFD477" Data="M 0,1 L 6,1 L 8,3 L 17,3 L 17,13 L 0,13 Z"/>
                    <Path Stroke="#FF8A6100" StrokeThickness="1" StrokeLineJoin="Round"
                          Data="M 0,1 L 6,1 L 8,3 L 17,3 L 17,13 L 0,13 Z"/>
                </Canvas>
            </Button>

            <!-- Settings gear - pops up the settings dialog -->
            <Button Grid.Column="8" Name="BtnSettings" Style="{StaticResource ToolButton}" Click="BtnSettings_Click"
                    ToolTip="Settings">
                <Canvas Width="16" Height="16">
                    <Path Fill="#FFE1E1E1" Data="M8,0 L9.8,2.3 L12.6,1.8 L13.1,4.6 L15.6,5.8 L14.1,8.2 L15.6,10.6 L13.1,11.8 L12.6,14.6 L9.8,14.1 L8,16.4 L6.2,14.1 L3.4,14.6 L2.9,11.8 L0.4,10.6 L1.9,8.2 L0.4,5.8 L2.9,4.6 L3.4,1.8 L6.2,2.3 Z"/>
                    <Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6" Fill="#FF3E3E42"/>
                </Canvas>
            </Button>

            <!-- Window caption controls -->
            <Button Grid.Column="9" Name="BtnMinimize" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                    Click="BtnMinimize_Click" ToolTip="Minimize"/>
            <Button Grid.Column="10" Name="BtnMaximize" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                    Click="BtnMaximize_Click" ToolTip="Maximize / Restore"/>
            <Button Grid.Column="11" Name="BtnClose" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                    Click="BtnClose_Click" ToolTip="Close"/>
        </Grid>

        <!--<ScrollViewer CanContentScroll="True" ScrollChanged="LV_ScrollChanged">-->
        <ListView Name="LV" Background="AliceBlue" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" SelectionMode="Multiple" HorizontalAlignment="Center">
            HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ImageViewer:SmartFlowPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <!--</ScrollViewer>-->


        <StatusBar Name="SB_Main" Grid.Row="2" Grid.Column="0" Background="#FF3E3E42" Foreground="#FFD0D0D0">
            <StatusBarItem>
                <TextBlock Width="30" Name="SB_Info1"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Width="250" Name="SB_Info2"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
