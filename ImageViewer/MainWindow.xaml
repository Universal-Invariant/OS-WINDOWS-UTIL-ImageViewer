<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ImageViewer="clr-namespace:ImageViewer"
        Title="Image Viewer" Height="600" Width="1000" MinWidth="760" MinHeight="300" Name="MainForm" WindowState="Normal"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowDrop="True"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Primary}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- WindowChrome: Windows itself handles dragging (empty toolbar space),
         double-click maximize, resizing from every edge, Snap, and maximizing
         within the work area. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Breadcrumb segment in the path box -->
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="5,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg.ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View options dropdown (opened from BtnView) -->
        <ContextMenu x:Key="ViewMenu">
            <MenuItem Header="Sort by" IsEnabled="False"/>
            <MenuItem Name="MI_SortName" Header="Name" IsCheckable="True" Tag="Name" Click="MI_Sort_Click"/>
            <MenuItem Name="MI_SortDate" Header="Date modified" IsCheckable="True" Tag="Date" Click="MI_Sort_Click"/>
            <MenuItem Name="MI_SortSize" Header="File size" IsCheckable="True" Tag="Size" Click="MI_Sort_Click"/>
            <MenuItem Name="MI_SortDims" Header="Dimensions" IsCheckable="True" Tag="Dimensions" Click="MI_Sort_Click"/>
            <Separator/>
            <MenuItem Name="MI_SortAsc" Header="Ascending" IsCheckable="True" Tag="Asc" Click="MI_SortDir_Click"/>
            <MenuItem Name="MI_SortDesc" Header="Descending" IsCheckable="True" Tag="Desc" Click="MI_SortDir_Click"/>
            <MenuItem Name="MI_Group" Header="Group by folder" IsCheckable="True" Click="MI_Group_Click"
                      ToolTip="With subfolders included: a header row per folder"/>
            <Separator/>
            <MenuItem Name="MI_Tiles" Header="Uniform tiles" IsCheckable="True" InputGestureText="T" Click="MI_Tiles_Click"/>
            <MenuItem Name="MI_Names" Header="Show file names" IsCheckable="True" InputGestureText="N" Click="MI_Names_Click"/>
            <Separator/>
            <MenuItem Name="MI_Spread" Header="Book view: two pages side by side" IsCheckable="True" Click="MI_Spread_Click"/>
            <MenuItem Name="MI_Cover" Header="Book view: cover page on its own" IsCheckable="True" Click="MI_Cover_Click"
                      ToolTip="Two pages side by side: the first page of each folder gets its own row, so pages pair like a printed book"/>
            <MenuItem Name="MI_Rtl" Header="Right to left" IsCheckable="True" Click="MI_Rtl_Click"/>
            <Separator/>
            <MenuItem Name="MI_Info" Header="Info panel" IsCheckable="True" InputGestureText="I" Click="MI_Info_Click"/>
            <MenuItem Name="MI_FullScreen" Header="Full screen" IsCheckable="True" InputGestureText="F11" Click="MI_FullScreen_Click"/>
            <Separator/>
            <MenuItem Header="Keyboard shortcuts and help" InputGestureText="F1" Click="MI_Help_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Toolbar / title bar ======================= -->
        <Grid Name="TB_Main" Background="{DynamicResource Bg.Chrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>                              <!-- app glyph -->
                <ColumnDefinition Width="Auto"/>                              <!-- back / forward -->
                <ColumnDefinition Width="3*" MinWidth="120" MaxWidth="600"/>  <!-- path box -->
                <ColumnDefinition Width="Auto"/>                              <!-- browse / refresh -->
                <ColumnDefinition Width="*" MinWidth="16"/>                   <!-- empty drag space -->
                <ColumnDefinition Width="2*" MinWidth="90" MaxWidth="220"/>   <!-- filter -->
                <ColumnDefinition Width="Auto"/>                              <!-- view tools -->
                <ColumnDefinition Width="Auto"/>                              <!-- caption buttons -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="14,0,6,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Name="BtnBack" Style="{StaticResource ToolButton}" Content="&#xE72B;" Width="30" FontSize="13"
                        Click="BtnBack_Click" IsEnabled="False" ToolTip="Back (Alt+←, mouse back button)"/>
                <Button Name="BtnForward" Style="{StaticResource ToolButton}" Content="&#xE72A;" Width="30" FontSize="13"
                        Click="BtnForward_Click" IsEnabled="False" ToolTip="Forward (Alt+→)"/>
            </StackPanel>

            <!-- Path box with a clickable breadcrumb drawn over it while not editing -->
            <Grid Grid.Column="2" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox x:Name="CB_Path" Style="{StaticResource PathComboBox}" MinWidth="120"
                          IsEditable="True" VerticalAlignment="Center"
                          KeyDown="CB_Path_KeyDown" TextBox.TextChanged="CB_Path_TextChanged"
                          DropDownClosed="CB_Path_DropDownClosed" SelectionChanged="CB_Path_SelectionChanged"
                          IsKeyboardFocusWithinChanged="CB_Path_FocusChanged"/>
                <Border x:Name="Crumbs" Margin="1,1,29,1" CornerRadius="5,0,0,5" Background="{DynamicResource Bg.Control}"
                        Cursor="IBeam" ClipToBounds="True" MouseLeftButtonUp="Crumbs_MouseLeftButtonUp"
                        SizeChanged="Crumbs_SizeChanged"
                        ToolTip="Click a folder to open it; click empty space to type a path. Ctrl+PageUp/PageDown: previous/next folder, Alt+↑: parent">
                    <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" Margin="3,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Name="BtnBrowse" Style="{StaticResource ToolButton}" Content="&#xE838;" Click="BtnBrowse_Click"
                        ToolTip="Open folder… (Ctrl+O)"/>
                <!-- Visible only when files were added/removed on disk -->
                <Button Name="BtnRefresh" Style="{StaticResource ToolButton}" Content="&#xE72C;" Click="BtnRefresh_Click"
                        Visibility="Collapsed" Foreground="{DynamicResource Danger}"
                        ToolTip="Files changed on disk - click to reload (F5)"/>
            </StackPanel>

            <!-- Filter -->
            <Grid Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBox x:Name="TB_Filter" Height="30" Padding="26,0,26,0" VerticalContentAlignment="Center"
                         TextChanged="TB_Filter_TextChanged"
                         ToolTip="Filter (Ctrl+F): show only images whose name or subfolder contains these words (all of them). Wildcards: *.png, img_0??. Esc clears."/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" IsHitTestVisible="False"
                           Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                <TextBlock x:Name="FilterHint" Text="Filter" IsHitTestVisible="False"
                           Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" Margin="29,0,0,0"/>
                <Button x:Name="BtnClearFilter" Style="{StaticResource ToolButton}" Content="&#xE711;" Width="24" Height="24"
                        FontSize="9" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed"
                        Click="BtnClearFilter_Click" ToolTip="Clear filter (Esc)"/>
            </Grid>

            <StackPanel Grid.Column="6" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ToolButton}" Content="&#xE71F;" Width="28" FontSize="13"
                        Click="BtnZoomOut_Click" ToolTip="Smaller (Ctrl+−, Ctrl+wheel)"/>
                <Slider x:Name="SD_Scale" Width="90" VerticalAlignment="Center" Margin="2,0"
                        Minimum="0.1" Maximum="4.0" Value="1.0" SmallChange="0.05" LargeChange="0.25"
                        MouseDoubleClick="SD_Scale_MouseDoubleClick"
                        ToolTip="Image scale (double-click to reset to 100%)"/>
                <Button Style="{StaticResource ToolButton}" Content="&#xE8A3;" Width="28" FontSize="13"
                        Click="BtnZoomIn_Click" ToolTip="Larger (Ctrl++, Ctrl+wheel)"/>
                <Button Name="BtnScalePct" Style="{StaticResource ToolButton}" Width="46" FontFamily="Segoe UI" FontSize="12"
                        Foreground="{DynamicResource Fg.Secondary}" Content="100%" Click="BtnScalePct_Click"
                        ToolTip="Reset scale to 100% (Ctrl+0)"/>

                <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Border.Control}"/>

                <ToggleButton Name="TGB_FitToWidth" Style="{StaticResource ToolToggle}" Content="&#xE9A6;"
                              Checked="TGB_FitToWidth_Changed" Unchecked="TGB_FitToWidth_Changed"
                              ToolTip="Book view: fit large images to the window width (F). Space pages through."/>
                <!-- Center pages (book view) / pack images (grid); see ToggleArrange -->
                <ToggleButton Name="TGB_Arrange" Style="{StaticResource ToolToggle}" Content="&#xF0E2;"
                              Click="TGB_Arrange_Click"/>
                <ToggleButton Name="TGB_ScrollByImage" Style="{StaticResource ToolToggle}" Content="&#xEC8F;"
                              Checked="TGB_ScrollByImage_Changed" Unchecked="TGB_ScrollByImage_Changed"
                              ToolTip="Mouse wheel scrolls one image row at a time instead of by pixels"/>
                <ToggleButton Name="TGB_Recurse" Style="{StaticResource ToolToggle}" Content="&#xED41;"
                              Checked="CB_Recurse_Changed" Unchecked="CB_Recurse_Changed"
                              ToolTip="Include subfolders"/>
                <!-- Backdrop behind transparent images: click cycles (B), Shift+click
                     goes back, right-click lists the choices. Shows the current one. -->
                <Button Name="BtnBackdrop" Style="{StaticResource ToolButton}" Click="BtnBackdrop_Click"
                        ContextMenuOpening="BtnBackdrop_ContextMenuOpening">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom"/>
                    </Button.ContextMenu>
                    <Border Name="BackdropSwatch" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{DynamicResource Fg.Secondary}" SnapsToDevicePixels="True"/>
                </Button>
                <Button Name="BtnView" Style="{StaticResource ToolButton}" Content="&#xE8CB;" Click="BtnView_Click"
                        ToolTip="Sort, group, tiles, file names, book layout"/>

                <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Border.Control}"/>

                <Button Name="BtnHelp" Style="{StaticResource ToolButton}" Content="&#xE897;" Click="MI_Help_Click"
                        ToolTip="Keyboard shortcuts and help (F1)"/>
                <Button Name="BtnSettings" Style="{StaticResource ToolButton}" Content="&#xE713;" Click="BtnSettings_Click"
                        ToolTip="Settings"/>
            </StackPanel>

            <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Name="BtnMinimize" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Click="BtnMinimize_Click" ToolTip="Minimize"/>
                <Button Name="BtnMaximize" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="BtnMaximize_Click" ToolTip="Maximize"/>
                <Button Name="BtnClose" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                        Click="BtnClose_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ======================= Image area ======================= -->
        <!-- A plain ScrollViewer around the virtualizing SmartFlowPanel: only
             rows near the viewport have elements (see SmartFlowPanel). The
             overlay template (App.xaml) floats the scrollbar over the images so
             the viewport width never changes when it appears. -->
        <ScrollViewer x:Name="LV" Grid.Row="1" Background="Black" Focusable="True" FocusVisualStyle="{x:Null}"
                      Template="{StaticResource OverlayScrollViewer}" CanContentScroll="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.ContextMenu>
                <ContextMenu Name="CM_Image">
                    <MenuItem Name="MI_Preview" Header="Preview" InputGestureText="Space" Click="MI_Preview_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE8A7;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_OpenExternal" Header="Open in default app" InputGestureText="Enter" Click="MI_OpenExternal_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE8AD;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_ShowInExplorer" Header="Show in Explorer" Click="MI_ShowInExplorer_Click">
                        <MenuItem.Icon><TextBlock Text="&#xEC50;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_Slideshow" Header="Slideshow from here" InputGestureText="S" Click="MI_Slideshow_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE768;"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Rotate right" InputGestureText="R" Tag="90" Click="MI_Rotate_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE7AD;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Rotate left" InputGestureText="Shift+R" Tag="-90" Click="MI_Rotate_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><ScaleTransform ScaleX="-1"/></TextBlock.RenderTransform></TextBlock>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Rotate 180°" Tag="180" Click="MI_Rotate_Click"/>
                    <MenuItem Name="MI_ResetRotation" Header="Reset rotation" Tag="reset" Click="MI_Rotate_Click"/>
                    <Separator/>
                    <MenuItem Name="MI_CopyImage" Header="Copy" InputGestureText="Ctrl+C" Click="MI_CopyImage_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE8C8;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_CopyPath" Header="Copy path" InputGestureText="Ctrl+Shift+C" Click="MI_CopyPath_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE71B;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_CopyTo" Header="Copy to folder…" Click="MI_CopyTo_Click">
                        <MenuItem.Icon><TextBlock Text="&#xF413;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_MoveTo" Header="Move to folder…" Click="MI_MoveTo_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE8DE;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="MI_Delete" Header="Delete" InputGestureText="Del" Click="MI_Delete_Click">
                        <MenuItem.Icon><TextBlock Text="&#xE74D;"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="MI_SelectAll_Click"/>
                </ContextMenu>
            </ScrollViewer.ContextMenu>
            <ImageViewer:SmartFlowPanel x:Name="GridPanel"/>
        </ScrollViewer>

        <!-- Indeterminate loading strip along the top of the image area -->
        <Rectangle Name="LoadingBar" Grid.Row="1" Height="2" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="LoadingBarShift" X="-1"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#004C9EEB" Offset="0"/>
                    <GradientStop Color="#FF4C9EEB" Offset="0.5"/>
                    <GradientStop Color="#004C9EEB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Empty state (no folder / no images / nothing matches the filter) -->
        <StackPanel Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="48"
                       Foreground="#FF5A5A5A" HorizontalAlignment="Center"/>
            <TextBlock Name="EmptyTitle" Text="No folder open" FontSize="18" Margin="0,14,0,4"
                       Foreground="{DynamicResource Fg.Primary}" HorizontalAlignment="Center"/>
            <TextBlock Name="EmptyHint" Text="Choose a folder or drop one onto this window."
                       Foreground="{DynamicResource Fg.Secondary}" HorizontalAlignment="Center"/>
            <Button Name="EmptyAction" Content="Open folder…" IsDefault="True" Margin="0,18,0,0" HorizontalAlignment="Center"
                    Click="EmptyAction_Click" Focusable="False"/>
        </StackPanel>

        <!-- Built-in preview (Space / double-click / context menu) -->
        <Grid Name="PreviewOverlay" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10" Background="#FF121212" Visibility="Collapsed"
              ClipToBounds="True"
              MouseLeftButtonDown="PreviewOverlay_MouseLeftButtonDown" MouseWheel="PreviewOverlay_MouseWheel">
            <!-- Explicit Width/Height are set in code (SizePreviewImage): small images
                 show 1:1, large ones fit the window, and the low-res placeholder and
                 the sharp decode occupy exactly the same box (no jump). -->
            <!-- Zoom and pan are a RenderTransform on top of the fitted box
                 (MainWindow.Preview.cs): Ctrl+wheel, +/-, Z, double-click, drag. -->
            <!-- Backdrop of a transparent image: same box and zoom transform as the image -->
            <Rectangle Name="PreviewBackdrop" Margin="56,24,56,56" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                       Width="{Binding Width, ElementName=PreviewImage}" Height="{Binding Height, ElementName=PreviewImage}"
                       RenderTransform="{Binding RenderTransform, ElementName=PreviewImage}"/>
            <Image Name="PreviewImage" Margin="56,24,56,56" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" MouseMove="PreviewImage_MouseMove"
                   MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" LostMouseCapture="PreviewImage_LostMouseCapture"/>

            <Button Style="{StaticResource ToolButton}" Content="&#xE76B;" Width="44" Height="64" FontSize="20"
                    Foreground="#FFE8E8E8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                    Click="PreviewPrev_Click" ToolTip="Previous (←)"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE76C;" Width="44" Height="64" FontSize="20"
                    Foreground="#FFE8E8E8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Click="PreviewNext_Click" ToolTip="Next (→)"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                <Button Style="{StaticResource ToolButton}" Content="&#xE7AD;" Width="40" Height="40" FontSize="14"
                        Foreground="#FFE8E8E8" Click="PreviewRotate_Click" ToolTip="Rotate right (R, Shift+R left)"/>
                <Button Name="BtnSlideshow" Style="{StaticResource ToolButton}" Content="&#xE768;" Width="40" Height="40" FontSize="14"
                        Foreground="#FFE8E8E8" Click="PreviewSlideshow_Click" ToolTip="Slideshow (S)"/>
                <Button Style="{StaticResource ToolButton}" Content="&#xE711;" Width="40" Height="40" FontSize="14"
                        Foreground="#FFE8E8E8" Click="PreviewClose_Click" ToolTip="Close preview (Esc)"/>
            </StackPanel>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                    Background="#CC202020" CornerRadius="6" Padding="12,6">
                <TextBlock Name="PreviewCaption" Foreground="#FFE8E8E8"/>
            </Border>
        </Grid>

        <!-- Info panel (I): file details and camera data of the image under the
             mouse / keyboard focus / in the preview (MainWindow.Info.cs) -->
        <Border Name="InfoPanel" Grid.Row="1" Width="300" HorizontalAlignment="Right" Panel.ZIndex="11"
                Background="{DynamicResource Bg.Chrome}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,10,6,4">
                    <TextBlock Text="Info" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE711;" Width="28" Height="28" FontSize="10"
                            HorizontalAlignment="Right" Click="MI_Info_Click" ToolTip="Close (I)"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="InfoRows" Margin="16,4,16,16"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Short confirmations ("Copied", "Rotated"...) at the top of the image area -->
        <Border Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                Panel.ZIndex="20" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed"
                Background="#E6202020" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="6" Padding="14,7">
            <TextBlock Name="ToastText" Foreground="#FFE8E8E8"/>
        </Border>

        <!-- Keyboard shortcuts and help (F1, ?) -->
        <Grid Name="HelpOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="30" Background="#99000000"
              Visibility="Collapsed" MouseLeftButtonDown="HelpOverlay_MouseLeftButtonDown">
            <Border Background="{DynamicResource Bg.Popup}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                    CornerRadius="8" Margin="40" MaxWidth="1100" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="22,14,10,4">
                        <TextBlock Text="Keyboard shortcuts and mouse" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ToolButton}" Content="&#xE711;" Width="30" Height="30" FontSize="10"
                                HorizontalAlignment="Right" Click="HelpClose_Click" ToolTip="Close (Esc)"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Margin="22,4,22,14" Foreground="{DynamicResource Fg.Secondary}" TextWrapping="Wrap"
                               Text="Keys act on the image under the mouse, or on the keyboard focus after using the arrow keys; with a selection, on all selected images."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel Name="HelpColumns" Margin="12,4,12,4"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <Grid Name="SB_Main" Grid.Row="2" Height="26" Background="{DynamicResource Bg.Chrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="SB_NumFilesRead" Grid.Column="0" Margin="12,0,16,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg.Secondary}"/>
            <TextBlock Name="SB_Size" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Fg.Secondary}"/>
            <TextBlock Name="SB_Mode" Grid.Column="2" Margin="16,0,14,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg.Secondary}"/>
        </Grid>
    </Grid>
</Window>
