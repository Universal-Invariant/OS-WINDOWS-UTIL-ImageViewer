<Window x:Class="ImageViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF2D2D30" Foreground="#FFE1E1E1">
    <StackPanel Margin="14">
        <TextBlock Text="Display" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Name="CHK_Recurse" Content="Search subdirectories (recursion)"
                      Margin="0,3" Foreground="#FFE1E1E1"/>
            <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Name="CHK_FitToWidth"
                      Content="Fit all images to the window width (&quot;book format&quot;)"
                      Margin="0,3" Foreground="#FFE1E1E1"
                      ToolTip="Every image is scaled so its width matches the window width. Images of similar size line up like pages of a book."/>
            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Name="CHK_ShowStatusBar" Content="Show status bar at the bottom"
                      Margin="0,3" Foreground="#FFE1E1E1"/>
            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Name="CHK_AutoRefresh"
                      Content="Auto-reload when files are added/removed in the folder"
                      Margin="0,3" Foreground="#FFE1E1E1"
                      ToolTip="Off: the refresh button simply turns red and waits for you to click it. On: the folder reloads automatically after a short quiet period (can be slow for very large folders)."/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Maximum image size (% of window):" VerticalAlignment="Center" Margin="0,6,8,2"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,2">
                <Slider Name="SL_MaxSize" Width="150" Minimum="10" Maximum="200" Value="100"
                        TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="SL_MaxSize_ValueChanged"/>
                <TextBlock Name="TB_MaxSize" Width="50" Margin="6,0,0,0" VerticalAlignment="Center" Text="100 %"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Default scale factor:" VerticalAlignment="Center" Margin="0,6,8,6"/>
            <TextBox Grid.Row="5" Grid.Column="1" Name="TB_Scale" Width="60" HorizontalAlignment="Left" Margin="0,6"
                     VerticalContentAlignment="Center" TextChanged="TB_Scale_TextChanged"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Background color:" VerticalAlignment="Center" Margin="0,6,8,6"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Border Name="BDR_Color" Width="40" Height="20" BorderBrush="#FF808080" BorderThickness="1" CornerRadius="3"/>
                <Button Content="Change..." Width="70" Height="22" Margin="8,0,0,0" Click="BtnPickColor_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Fit-to-width min. image size (px):" VerticalAlignment="Center" Margin="0,6,8,6"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Slider Name="SL_MinFitPx" Width="150" Minimum="0" Maximum="2000" Value="500"
                        TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="SL_MinFitPx_ValueChanged"
                        ToolTip="Only images at least this large are scaled up to the window width in book format; smaller ones (icons) keep their scale and flow in between."/>
                <TextBlock Name="TB_MinFitPx" Width="60" Margin="6,0,0,0" VerticalAlignment="Center" Text="500 px"/>
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Scroll overlap when paging (%):" VerticalAlignment="Center" Margin="0,6,8,6"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Slider Name="SL_Undershoot" Width="150" Minimum="0" Maximum="50" Value="10"
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="SL_Undershoot_ValueChanged"
                        ToolTip="When scroll-by-image pages through an image taller than the window, each notch moves one viewport height MINUS this overlap so a strip of the previous screen stays visible for orientation. Row-to-row snapping is unaffected."/>
                <TextBlock Name="TB_Undershoot" Width="50" Margin="6,0,0,0" VerticalAlignment="Center" Text="10 %"/>
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Rows per wheel notch:" VerticalAlignment="Center" Margin="0,6,8,6"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Slider Name="SL_NotchRows" Width="150" Minimum="1" Maximum="5" Value="1"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="SL_NotchRows_ValueChanged"
                        ToolTip="Scroll-by-image: how many image rows (or viewport page steps inside a tall book page) one full wheel notch moves. High-precision touchpad deltas accumulate until they add up to a full notch."/>
                <TextBlock Name="TB_NotchRows" Width="50" Margin="6,0,0,0" VerticalAlignment="Center" Text="1"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="Btn_OK" Content="OK" Width="70" Height="24" Margin="0,0,8,0" IsDefault="True" Click="Btn_OK_Click"/>
            <Button Name="Btn_Cancel" Content="Cancel" Width="70" Height="24" IsCancel="True" Click="Btn_Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
